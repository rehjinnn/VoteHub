@model VoteHub.Models.Election

@{
    ViewData["Title"] = "Vote Confirmation";
}

<div class="container mt-5">
    <div class="card shadow border-success">
        <div class="card-header bg-success text-white">
            <h2 class="mb-0"><i class="fas fa-check-circle"></i> Vote Confirmed</h2>
        </div>
        <div class="card-body">
            <div class="alert alert-success">
                Your vote for <strong>@Model.Title</strong> has been recorded successfully.
            </div>
            <a href="/Home/Index" class="btn btn-msu">
                <i class="fas fa-home"></i> Back to Home
            </a>
        </div>
    </div>
</div>