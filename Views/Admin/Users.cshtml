@model List<VoteHub.Models.User>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container-fluid mt-5">
    <h1 class="mb-4"><i class="fas fa-users"></i> Manage Users</h1>

    <div class="card shadow">
        <div class="card-header bg-msu text-white">
            <h5 class="mb-0">All Users (@Model.Count)</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Member Since</th>
                            <th>Last Login</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.UserId</td>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge" style="background-color: @(user.Role == "Admin" ? "red" : "green");">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>@(user.LastLogin != DateTime.MinValue ? user.LastLogin.ToString("MMM dd, yyyy HH:mm") : "Never")</td>
                                <td>
                                    @if (!user.IsActive)
                                    {
                                        <form method="post" action="/Admin/DeactivateUser/@user.UserId" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-success">Activate</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <a href="/Admin/Dashboard" class="btn btn-secondary mt-3">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
</div>