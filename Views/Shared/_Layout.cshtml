<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VoteHub - Online Voting System</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var bodyClass = isHome ? "homepage" : string.Empty;
    bool isDashboard = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Dashboard", StringComparison.OrdinalIgnoreCase);
    bool isMyElections = string.Equals(currentController, "Election", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "MyElections", StringComparison.OrdinalIgnoreCase);
    bool isCreateElection = string.Equals(currentController, "Election", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Create", StringComparison.OrdinalIgnoreCase);
    bool isAdminDashboard = string.Equals(currentController, "Admin", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Dashboard", StringComparison.OrdinalIgnoreCase);
    bool isLogin = string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase);
    bool isRegister = string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Register", StringComparison.OrdinalIgnoreCase);
}
<body class="d-flex flex-column min-vh-100 @bodyClass">
    <!-- Navigation Bar -->
    <nav id="mainNavbar" class="navbar navbar-expand-lg navbar-transparent sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="~/images/msu-logo.png" class="msu-logo me-2" alt="Mindoro State University" />
                <span class="msu-name me-3">Mindoro State University</span>
                <span class="site-name fw-bold">VoteHub</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link @(isHome ? "active" : "")" href="/">Home</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isDashboard ? "active" : "")" href="/Home/Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isMyElections ? "active" : "")" href="/Election/MyElections">My Elections</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isCreateElection ? "active" : "")" href="/Election/Create">
                                <i class="fas fa-plus"></i> Create Election
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isAdminDashboard ? "active" : "")" href="/Admin/Dashboard">
                                    <i class="fas fa-cog"></i> Admin
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle"></i> @User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" href="/Account/Profile">
                                        <i class="fas fa-user"></i> Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" action="/Account/Logout" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item" style="background: none; border: none; cursor: pointer;">
                                            <i class="fas fa-sign-out-alt"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isLogin ? "active" : "")" href="/Account/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isRegister ? "active" : "")" href="/Account/Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="py-4 flex-grow-1">
        <div class="container page-panel">
            <!-- Alert Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i> <strong>Success!</strong> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle"></i> <strong>Error!</strong> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle"></i> <strong>Warning!</strong> @TempData["Warning"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- THIS IS CRITICAL - RENDER PAGE CONTENT HERE -->
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2024 VoteHub. All rights reserved. | Secure Online Voting System</p>
            <small class="text-muted">For Educational & Organizational Use</small>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

